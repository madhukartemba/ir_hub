#pragma once

// Copy this file to include/secrets.h. The build copies it automatically when
// include/secrets.h is missing. Never commit secrets.h.
//
// All four values below are *compile-time defaults*. They are used only when
// LittleFS has no `/mqtt.json` (i.e. the device has never been configured).
// After Wi-Fi/MQTT setup via the captive portal, the entered values are saved
// to the device and override these defaults.
//
// Ship the firmware with these left blank. An empty MQTT_HOST disables MQTT
// entirely until the user configures it from the captive portal.

#define MQTT_HOST ""
#define MQTT_PORT 1883
#define MQTT_USER ""
#define MQTT_PASSWORD ""
